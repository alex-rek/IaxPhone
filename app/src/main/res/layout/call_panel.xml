<?xml version="1.0" encoding="utf-8"?>
<!-- Экран разговора: показывается поверх вкладок, пока есть вызов -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/call_bg"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- Громкость слева, индикатор записи по центру, статистика справа -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp">

        <ImageButton
            android:id="@+id/volume"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="start"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/volume"
            android:src="@drawable/ic_tune"
            app:tint="#CCFFFFFF" />

        <TextView
            android:id="@+id/recIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawablePadding="6dp"
            android:gravity="center_vertical"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:visibility="gone"
            app:drawableStartCompat="@drawable/ic_record"
            app:drawableTint="@color/red" />

        <ImageButton
            android:id="@+id/stats"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/stats"
            android:src="@drawable/ic_stats"
            app:tint="#CCFFFFFF" />
    </FrameLayout>

    <TextView
        android:id="@+id/callName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:textColor="@android:color/white"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/callNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="#B3FFFFFF"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/callStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/dtmfSent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:letterSpacing="0.1"
        android:minHeight="28dp"
        android:textColor="@android:color/white"
        android:textSize="22sp" />

    <!-- Клавиатура DTMF; уменьшается, если не помещается по высоте -->
    <FrameLayout
        android:id="@+id/keypadArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/callKeypad"
            layout="@layout/keypad"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Микрофон / клавиатура / динамик -->
    <LinearLayout
        android:id="@+id/inCallControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal">

        <LinearLayout style="@style/CallControlCell">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/mute"
                style="@style/CallControl"
                android:checkable="true"
                android:contentDescription="@string/mute"
                app:icon="@drawable/ic_mic_off" />
            <TextView style="@style/CallControlLabel" android:text="@string/mute" />
        </LinearLayout>

        <LinearLayout style="@style/CallControlCell">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/keypadToggle"
                style="@style/CallControl"
                android:checkable="true"
                android:contentDescription="@string/keypad"
                app:icon="@drawable/ic_dialpad" />
            <TextView style="@style/CallControlLabel" android:text="@string/keypad" />
        </LinearLayout>

        <LinearLayout style="@style/CallControlCell">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/speaker"
                style="@style/CallControl"
                android:checkable="true"
                android:contentDescription="@string/speaker"
                app:icon="@drawable/ic_speaker" />
            <TextView style="@style/CallControlLabel" android:text="@string/speaker" />
        </LinearLayout>
    </LinearLayout>

    <!-- Удержание / завершить (ответить) / запись -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical"
        android:minHeight="72dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/holdCell"
            style="@style/CallControlCell">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/hold"
                style="@style/CallActionPlain"
                android:contentDescription="@string/hold"
                app:icon="@drawable/ic_pause"
                app:iconTint="@color/call_hold_fg" />
            <TextView
                android:id="@+id/holdLabel"
                style="@style/CallControlLabel"
                android:layout_marginTop="0dp"
                android:text="@string/hold" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/hangup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/hangup"
            android:src="@drawable/ic_call_end"
            app:backgroundTint="@color/red"
            app:fabCustomSize="68dp"
            app:maxImageSize="30dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:tint="@android:color/white" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/answer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:contentDescription="@string/answer"
            android:src="@drawable/ic_call"
            app:backgroundTint="@color/green"
            app:fabCustomSize="68dp"
            app:maxImageSize="30dp"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:tint="@android:color/white" />

        <LinearLayout
            android:id="@+id/recordCell"
            style="@style/CallControlCell">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/record"
                style="@style/CallActionPlain"
                android:contentDescription="@string/record"
                app:icon="@drawable/ic_record"
                app:iconTint="@color/call_record_fg" />
            <TextView
                android:id="@+id/recordLabel"
                style="@style/CallControlLabel"
                android:layout_marginTop="0dp"
                android:text="@string/record" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
