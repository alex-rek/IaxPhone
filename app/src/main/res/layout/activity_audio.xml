<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/top_bar"
        android:minHeight="?attr/actionBarSize"
        android:theme="@style/TopBarOverlay"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@android:color/white"
        app:title="@string/audio"
        app:titleTextColor="@android:color/white" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Клавиатура -->
            <TextView style="@style/SettingsSection" android:text="@string/audio_keypad" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/keyVibrate"
                style="@style/SettingsSwitch"
                android:text="@string/audio_key_vibrate" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/keySound"
                style="@style/SettingsSwitch"
                android:text="@string/audio_key_sound" />

            <!-- Вызов -->
            <TextView style="@style/SettingsSection" android:text="@string/audio_call" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/echoCancel"
                style="@style/SettingsSwitch"
                android:text="@string/audio_echo" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/noiseSuppress"
                style="@style/SettingsSwitch"
                android:text="@string/audio_noise" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/autoGain"
                style="@style/SettingsSwitch"
                android:text="@string/audio_agc" />

            <TextView
                android:id="@+id/effectsHint"
                style="@style/SettingsHint"
                android:text="@string/audio_effects_hint" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/proximity"
                style="@style/SettingsSwitch"
                android:text="@string/audio_proximity" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/audio_proximity_hint" />

            <!-- Громкость -->
            <TextView style="@style/SettingsSection" android:text="@string/audio_volume" />

            <TextView
                android:id="@+id/speakerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/key_text"
                android:textSize="16sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/speakerGain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/audio_speaker_gain"
                android:stepSize="1"
                android:valueFrom="-6"
                android:valueTo="12"
                app:labelBehavior="gone" />

            <TextView
                android:id="@+id/micLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/key_text"
                android:textSize="16sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/micGain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/audio_mic_gain"
                android:stepSize="1"
                android:valueFrom="-6"
                android:valueTo="12"
                app:labelBehavior="gone" />

            <TextView
                style="@style/SettingsHint"
                android:text="@string/audio_gain_hint" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
